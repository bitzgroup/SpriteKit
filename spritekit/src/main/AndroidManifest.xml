<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Captures the application Context at app start-up so SKTexture(imageNamed) can read the
             host app's assets/ before any SKView exists, as Apple's main-bundle lookup can. -->
        <provider
            android:name="jp.co.bitz.spritekit.SKBundleInitializer"
            android:authorities="${applicationId}.jp.co.bitz.spritekit.bundle"
            android:exported="false" />
    </application>

</manifest>
